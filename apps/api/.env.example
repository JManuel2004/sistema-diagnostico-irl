NODE_ENV=development
APP_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://irl_user:irl_dev_password@localhost:5433/irl_diagnostic
DATABASE_SCHEMA_DIAGNOSTIC=irl_diagnostic
DATABASE_SCHEMA_CATALOG=irl_catalog

# Cognito — validation of the user's access token.
# The same User Pool INNLAB Core uses: ask the Core team for it; do not
# create a new User Pool or build the URL from a region of your own.
# PLACEHOLDER — blocking for testing against a real JWT.
COGNITO_JWKS_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>/.well-known/jwks.json
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>

# innlab-core-api — outgoing calls to /internal/*.
# Authentication is the static `x-internal-key` key, NOT OAuth
# client_credentials. The Core team registers it by hand in its
# internal.guard.ts (SERVICE_KEY_ENV); there is no self-service.
# PLACEHOLDER — blocking for HU-02 (user context).
INNLAB_API_BASE_URL=http://localhost:8081
INNLAB_API_TIMEOUT=5000
CORE_INTERNAL_KEY=ask_the_core_team_for_this_key

LOG_LEVEL=debug

# Mail of the finished report to INNLAB (HU-25). Leave REPORT_NOTIFY_TO
# empty to disable it: the report stays on screen.
# Locally, `pnpm db:up` starts Mailpit on SMTP. It shows every message at
# http://localhost:8025 and does not deliver outside this machine.
# On a free Render service, set RESEND_API_KEY instead and leave SMTP_HOST
# empty. Resend sends over HTTPS. Until a domain is verified, the sender
# is onboarding@resend.dev and the inbox must be the Resend account.
REPORT_NOTIFY_TO=prueba@innlab.local
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@innlab.icesi.edu.co

# Testing only. Leave false outside validation. Set true on the API host
# and restart it: if INNLAB auth fails to answer within 2s three times in
# a row, the app enters on its own as the test leader. A prompt answer
# from INNLAB keeps the real login. Set it back to false when validation
# ends. No frontend rebuild.
AUTH_BYPASS=false
# Optional. Signs the local session. Empty uses a built-in key.
AUTH_BYPASS_SECRET=
