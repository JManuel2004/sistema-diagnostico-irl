NODE_ENV=development
APP_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://irl_user:irl_dev_password@localhost:5432/irl_diagnostic
DATABASE_SCHEMA_DIAGNOSTIC=irl_diagnostic
DATABASE_SCHEMA_CATALOG=irl_catalog

# Keycloak — local development realm
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/innlab-dev
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/innlab-dev/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=diagnostico-irl-api

# InnLab Core API — local mock or sandbox
INNLAB_CORE_BASE_URL=http://localhost:8081
INNLAB_CORE_CLIENT_ID=diagnostico-irl
INNLAB_CORE_CLIENT_SECRET=changeme

# SMTP — for local, use Mailpit or similar
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM=noreply@innlab.icesi.edu.co

LOG_LEVEL=debug
