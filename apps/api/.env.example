NODE_ENV=development
APP_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://irl_user:irl_dev_password@localhost:5433/irl_diagnostic
DATABASE_SCHEMA_DIAGNOSTIC=irl_diagnostic
DATABASE_SCHEMA_CATALOG=irl_catalog

# Cognito — validacion del access token de usuario.
# Mismo User Pool que usa INNLAB Core: pideselo al equipo de Core, no
# crees un User Pool nuevo ni armes la URL a partir de una region propia.
# PLACEHOLDER — bloqueante para probar contra un JWT real.
COGNITO_JWKS_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>/.well-known/jwks.json
COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>

# innlab-core-api — llamadas salientes a /internal/*.
# La autenticacion es la key estatica `x-internal-key`, NO OAuth
# client_credentials. La registra a mano el equipo de Core en su
# internal.guard.ts (SERVICE_KEY_ENV); no hay self-service.
# PLACEHOLDER — bloqueante para HU-02 (contexto de usuario).
INNLAB_API_BASE_URL=http://localhost:8081
INNLAB_API_TIMEOUT=5000
CORE_INTERNAL_KEY=pide_esta_key_al_equipo_de_core

# SMTP — for local, use Mailpit or similar
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM=noreply@innlab.icesi.edu.co

LOG_LEVEL=debug
