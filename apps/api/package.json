{
  "name": "@innlab/api",
  "version": "0.0.1",
  "description": "IRL Diagnostic backend — NestJS + Fastify + TypeORM",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "contracts:build": "pnpm --filter @innlab/contracts build",
    "build": "pnpm contracts:build && nest build",
    "dev": "pnpm contracts:build && nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "pnpm contracts:build && tsc --noEmit",
    "test": "pnpm contracts:build && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "test:unit": "pnpm contracts:build && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "pnpm contracts:build && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --selectProjects integration",
    "test:e2e": "pnpm contracts:build && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --selectProjects e2e",
    "test:cov": "pnpm contracts:build && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage",
    "test:watch": "pnpm contracts:build && node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --watch",
    "db:migration:generate": "pnpm typeorm migration:generate -d src/shared/kernel/infrastructure/database/data-source.ts",
    "db:migration:create": "pnpm typeorm migration:create",
    "db:migration:run": "pnpm typeorm migration:run -d src/shared/kernel/infrastructure/database/data-source.ts",
    "db:migration:revert": "pnpm typeorm migration:revert -d src/shared/kernel/infrastructure/database/data-source.ts",
    "db:seed": "pnpm contracts:build && tsx src/shared/kernel/infrastructure/database/seeds/index.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@innlab/contracts": "workspace:^",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.8.4",
    "joi": "^18.2.1",
    "jwks-rsa": "^4.0.1",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.29",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^4.8.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "nock": "^14.0.15",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
