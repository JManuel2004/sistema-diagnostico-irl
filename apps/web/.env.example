VITE_API_BASE_URL=http://localhost:3000/api/v1

# INNLAB hub (innlab-core-user-space) — where a user without a session is
# sent: {VITE_CORE_URL}/auth/sso?redirect=<our callback url>
# PLACEHOLDER — pending from the Core team.
VITE_CORE_URL=http://localhost:5174

# Unused by the SPA. The API exchanges the code and checks the session.
# Kept so an old env file still matches this example.
VITE_CORE_API_URL=http://localhost:8081

# Development autofill (AgroConecta case). Only `.env.development` turns it
# on; never define it in a production environment.
# VITE_DEV_AUTOFILL=true

# Simulated sign-in: the two INNLAB addresses point at the simulator. Put
# them in `.env.local` together with the API's four values (see
# apps/api/.env.example) and delete that file to go back to the real mode.
# VITE_CORE_URL=http://localhost:8090
# VITE_CORE_API_URL=http://localhost:8090/api
