# Entorno fijo para vitest. Tiene prioridad sobre .env.local (Vite ordena
# .env.[mode] por encima de .env.local), de modo que los tests no dependen
# de las URLs reales que cada quien tenga en su maquina — y sobre todo, no
# salen a los servicios de Core de verdad.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_CORE_URL=https://hub.test
VITE_CORE_API_URL=https://core-api.test
