# Fixed environment for vitest. It takes precedence over .env.local (Vite
# ranks .env.[mode] above .env.local), so the tests do not depend on the
# real URLs each developer has on their machine — and above all, never
# reach the real Core services.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_CORE_URL=https://hub.test
VITE_CORE_API_URL=https://core-api.test
